{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milifix.com/schemas/accelerated-execution/scene-plan.schema.json",
  "title": "Accelerated Execution Scene Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "media", "shots"],
  "properties": {
    "version": { "const": "0.1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "name", "size", "modifiedAt", "fingerprint"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "modifiedAt": { "type": "string", "format": "date-time" },
        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "const": "sha256-sampled-v1" },
            "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "duration", "frameRateMode"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "frameRateMode": { "enum": ["cfr", "vfr", "unknown"] },
        "averageFrameRate": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "nominalFrameRate": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "timeBase": { "type": ["string", "null"] },
        "frameCount": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "startTime", "endTime", "tasks"],
        "properties": {
          "id": { "type": "string" },
          "startTime": { "type": "number", "minimum": 0 },
          "endTime": { "type": "number", "minimum": 0 },
          "startFrame": { "type": "integer", "minimum": 0 },
          "endFrame": { "type": "integer", "minimum": 0 },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "engine", "anchorTime"],
              "properties": {
                "type": { "enum": ["roto", "planar-track", "point-track", "camera-track", "static-mask"] },
                "engine": { "enum": ["ae-native", "mocha", "local-ai", "vision"] },
                "action": { "enum": ["object-matte", "roto-brush", "static-mask", "mocha-planar-track", "motion-tracker", "camera-tracker", "sam-segmentation", "vision-segmentation"] },
                "anchorTime": { "type": "number", "minimum": 0 },
                "anchorFrame": { "type": "integer", "minimum": 0 },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["featherPixels", "expansionPixels"],
                  "properties": {
                    "featherPixels": { "type": "number", "minimum": 0, "maximum": 500 },
                    "expansionPixels": { "type": "number", "minimum": -500, "maximum": 500 }
                  }
                },
                "fallbacks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["engine", "action", "condition"],
                    "properties": {
                      "engine": { "enum": ["ae-native", "mocha", "local-ai", "vision"] },
                      "action": { "enum": ["object-matte", "roto-brush", "static-mask", "mocha-planar-track", "motion-tracker", "camera-tracker", "sam-segmentation", "vision-segmentation"] },
                      "condition": { "enum": ["unavailable", "quality-failed", "semantic-ambiguity"] }
                    }
                  }
                },
                "target": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "coordinateSpace", "x", "y"],
                      "properties": {
                        "kind": { "const": "point" },
                        "coordinateSpace": { "const": "normalized-source" },
                        "x": { "type": "number", "minimum": 0, "maximum": 1 },
                        "y": { "type": "number", "minimum": 0, "maximum": 1 }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "coordinateSpace", "x", "y", "width", "height"],
                      "properties": {
                        "kind": { "const": "box" },
                        "coordinateSpace": { "const": "normalized-source" },
                        "x": { "type": "number", "minimum": 0, "maximum": 1 },
                        "y": { "type": "number", "minimum": 0, "maximum": 1 },
                        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
                      }
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": { "properties": { "type": { "const": "roto" } }, "required": ["type"] },
                  "then": { "required": ["target"] }
                },
                {
                  "if": { "properties": { "type": { "const": "static-mask" } }, "required": ["type"] },
                  "then": {
                    "required": ["target", "parameters"],
                    "properties": { "target": { "properties": { "kind": { "const": "box" } } } }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
