{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milifix.com/schemas/accelerated-execution/scene-plan.schema.json",
  "title": "Accelerated Execution Scene Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "shots"],
  "properties": {
    "version": { "const": "0.1" },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "startFrame", "endFrame", "tasks"],
        "properties": {
          "id": { "type": "string" },
          "startFrame": { "type": "integer", "minimum": 0 },
          "endFrame": { "type": "integer", "minimum": 0 },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "engine"],
              "properties": {
                "type": { "enum": ["roto", "planar-track", "point-track", "camera-track", "static-mask"] },
                "engine": { "enum": ["ae-native", "mocha", "local-ai", "vision"] },
                "anchorFrame": { "type": "integer", "minimum": 0 },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
