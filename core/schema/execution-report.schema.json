{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milifix.com/schemas/accelerated-execution/execution-report.schema.json",
  "title": "Accelerated Execution Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "planVersion", "executedAt", "source", "executor", "destination", "summary", "shots"],
  "properties": {
    "version": { "const": "0.1" },
    "planVersion": { "const": "0.1" },
    "executedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "name", "size", "modifiedAt", "fingerprint"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "modifiedAt": { "type": "string", "format": "date-time" },
        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "const": "sha256-sampled-v1" },
            "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "action"],
      "properties": {
        "engine": { "enum": ["ae-native", "mocha", "local-ai", "vision"] },
        "action": { "enum": ["object-matte", "roto-brush", "static-mask", "mocha-planar-track", "motion-tracker", "camera-tracker", "sam-segmentation", "vision-segmentation"] }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compName", "layerName"],
      "properties": {
        "compName": { "type": "string", "minLength": 1 },
        "layerName": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "warning", "failed", "skipped"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "action"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["completed", "warning", "failed", "skipped"] },
          "action": { "type": "string", "minLength": 1 },
          "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
          "message": { "type": "string", "minLength": 1 },
          "recommendation": { "enum": ["review-target", "adjust-layer-range", "retry-anchor", "use-next-fallback"] },
          "fallback": {
            "type": "object",
            "additionalProperties": false,
            "required": ["engine", "action", "condition"],
            "properties": {
              "engine": { "enum": ["ae-native", "mocha", "local-ai", "vision"] },
              "action": { "type": "string", "minLength": 1 },
              "condition": { "enum": ["unavailable", "quality-failed", "semantic-ambiguity"] }
            }
          }
        }
      }
    }
  }
}
